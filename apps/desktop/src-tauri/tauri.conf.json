{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NLMX",
  "version": "0.3.1",
  "identifier": "dev.nlmx.desktop",
  "build": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "copyright": "© 2026 NLMX",
    "shortDescription": "Pergunte aos seus documentos, localmente.",
    "longDescription": "NLMX importa PDF, Markdown, TXT, CSV/TSV, EPUB, DOCX e XLSX, indexa localmente e responde com citações usando o Apple Foundation Models. Nada sai do Mac.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/llama-server"
    ],
    "resources": {
      "licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "27.0",
      "frameworks": [
        "frameworks/libggml-base.0.dylib",
        "frameworks/libggml-blas.0.dylib",
        "frameworks/libggml-cpu.0.dylib",
        "frameworks/libggml-metal.0.dylib",
        "frameworks/libggml-rpc.0.dylib",
        "frameworks/libggml.0.dylib",
        "frameworks/libllama-common.0.dylib",
        "frameworks/libllama-server-impl.dylib",
        "frameworks/libllama.0.dylib",
        "frameworks/libmtmd.0.dylib",
        "frameworks/libpdfium.dylib"
      ],
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 560,
          "height": 360
        },
        "appPosition": {
          "x": 150,
          "y": 175
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 175
        }
      }
    }
  }
}
